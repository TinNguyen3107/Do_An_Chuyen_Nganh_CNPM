# ════════════════════════════════════════════════════════════════
# 26Tech LMS — Backend Environment Variables
# ════════════════════════════════════════════════════════════════
# Hướng dẫn: Copy file này thành .env rồi điền giá trị thực tế
#   cp .env.example .env
# ⚠️  KHÔNG commit file .env lên Git
# ════════════════════════════════════════════════════════════════

# ── Môi trường ───────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB ──────────────────────────────────────────────────────
# Dùng MongoDB Atlas (cloud) hoặc local
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>
# Local:  mongodb://localhost:27017/<dbname>
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/26tech_lms

# ── JWT ──────────────────────────────────────────────────────────
# Tạo secret ngẫu nhiên, ví dụ: openssl rand -hex 64
JWT_SECRET=your_jwt_secret_at_least_32_chars_long

# ── Client URL ───────────────────────────────────────────────────
# URL frontend (dùng trong CORS)
CLIENT_URL=http://localhost:5173

# ── Tài khoản Admin mặc định ─────────────────────────────────────
# Được tạo tự động khi server khởi động lần đầu
ADMIN_NAME=Admin 26Tech
ADMIN_EMAIL=admin@26tech.vn
ADMIN_PASSWORD=Admin@123456

# ── Email / Nodemailer ───────────────────────────────────────────
# Dùng Gmail App Password (không phải mật khẩu Gmail thường)
# Hướng dẫn tạo App Password: https://myaccount.google.com/apppasswords
# Để trống nếu muốn bỏ qua gửi email ở môi trường dev
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM=26Tech <your_email@gmail.com>

# ── Thanh toán MoMo ──────────────────────────────────────────────
# Lấy thông tin từ: https://developers.momo.vn/
# Môi trường test dùng: https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:5173/payment-result
MOMO_IPN_URL=http://localhost:5000/api/payments/momo/ipn

# ── Thanh toán thẻ ATM (Bank transfer info) ──────────────────────
BANK_NAME=Vietcombank
BANK_CODE=VCB
BANK_ACCOUNT_NUMBER=your_account_number
BANK_ACCOUNT_NAME=YOUR COMPANY NAME
BANK_BRANCH=CN Ha Noi
